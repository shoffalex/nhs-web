# FastAPI service unit.
#
#   sudo cp deploy/systemd/nhs-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nhs-api
#   systemctl status nhs-api
#   journalctl -u nhs-api -f
#
# Assumes: repo at /home/alex/GitHub/nhs-web, venv at
# /home/alex/GitHub/nhs-web/backend/.venv, a system user `nhs`, and
# /var/lib/nhs-web owned by that user.
# See deploy/deploy.sh for the one-time setup that creates all of it.

[Unit]
Description=Pine View School NHS calendar API
After=network.target

[Service]
Type=simple
User=nhs
Group=nhs
WorkingDirectory=/home/alex/GitHub/nhs-web/backend

# Secrets live here, root-owned, mode 600 — never in the repo.
EnvironmentFile=/etc/nhs-web.env

ExecStart=/home/alex/GitHub/nhs-web/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=3s

# Only bind on loopback; Caddy is the only thing that should reach this.
# Hardening: the service reads its code from /home/alex (hence read-only, not
# true) and writes nothing but the SQLite file in /var/lib/nhs-web.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/nhs-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
