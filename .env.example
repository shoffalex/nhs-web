# Template for the backend's environment. Copy, fill in, and never commit the
# result.
#
#   local dev   backend/.env        (or just use ./scripts/dev.sh, which exports
#                                    working dev values for you)
#   production  /etc/nhs-web.env    root-owned, mode 600, read by systemd
#
# Every variable is prefixed NHS_ (see backend/app/config.py).

# Where the SQLite file lives. In production keep this OUTSIDE the repo, or a
# deploy will clobber live data.
NHS_DB_PATH=/var/lib/nhs-web/calendar.db

# Signs admin tokens. Generate with:  openssl rand -hex 32
# Changing it invalidates every issued token, which is your "log everyone out".
NHS_SECRET_KEY=

# The single shared password for the admin page. Until both this and
# NHS_SECRET_KEY are set, the API refuses every write with a 503 — so a
# half-configured server can never accept anonymous edits.
NHS_ADMIN_PASSWORD=

# How long an admin session lasts.
NHS_TOKEN_TTL_HOURS=12

# Only needed when the site and API are on different origins, i.e. local dev.
# In production Caddy puts both on one origin, so set this to [].
NHS_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
